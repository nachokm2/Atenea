# Copia este archivo a `.env` y rellena lo que necesites.
#
# Los valores por defecto son los de desarrollo local: sirven para levantar
# Atenea en tu máquina y **no** sirven en producción. Con ENVIRONMENT=production
# o staging, el arranque comprueba todo esto y se niega a levantar si falta algo,
# diciendo exactamente qué. Es a propósito: un servidor mal configurado no falla,
# responde 200 y hace daño en silencio.

# ------- Entorno -------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------- Base de datos -------
# psycopg3 síncrono: el esquema tiene que ser `postgresql+psycopg://`.
DATABASE_URL=postgresql+psycopg://atenea:atenea_dev@localhost:55432/atenea

# ------- Seguridad -------
# En producción: al menos 32 caracteres y distinto del de desarrollo, que está
# publicado en el repositorio. Con el de desarrollo, cualquiera firma un token
# con el identificador de otro aprendiz y lee su material.
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=60

# Orígenes del cliente web, en JSON. Vacío en producción es un error de arranque:
# sin lista, CORS quedaría en comodín y cualquier página podría hablar con la API
# en nombre de quien la visite. En desarrollo se acepta cualquier `localhost`.
CORS_ORIGINS=[]

# ------- IA -------
# mock  = proveedor determinista sin coste, para desarrollo y pruebas
# claude = Claude real (requiere ANTHROPIC_API_KEY)
# En producción `mock` es un error de arranque: serviría lecciones inventadas
# que parecen buenas.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_ARCHITECT=claude-opus-5
AI_MODEL_AUTHOR=claude-sonnet-5
AI_MODEL_JUDGE=claude-haiku-4-5

# ------- Embeddings -------
# mock | voyage | openai. Esta variable decide **quién** genera los vectores, y
# tiene que ir de la mano con la clave que haya puesta aquí. El modelo y las
# dimensiones salen de `ai.embeddings` en game_configs, no de aquí.
#
# En producción `mock` es un error de arranque: fabrica vectores a partir de un
# hash, así que la búsqueda por significado devolvería fragmentos al azar y las
# lecciones saldrían con citas que no vienen al caso. Eso no se ve hasta que
# alguien lee con atención, que es lo que lo hace peligroso.
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_DIM=512
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ------- Almacenamiento -------
# Ruta absoluta en producción, y dentro del volumen. Una ruta relativa se
# resuelve fuera del directorio de la aplicación, donde el contenedor no puede
# escribir, y la primera subida devuelve un 500.
STORAGE_DIR=./storage

# ------- Procesador de trabajos -------
# `true` corre el worker dentro del proceso de la API. Hace falta mientras el
# material viva en disco, porque un volumen se monta en un solo servicio y una
# API y un worker separados no compartirían los archivos. En local se deja en
# `false` y se arranca aparte con `python -m app.worker`.
WORKER_EN_PROCESO=false

# ------- Correo (solo para recuperar la contraseña) -------
# consola = escribe el mensaje en el registro en vez de enviarlo. Sirve para
# recorrer el flujo entero en local: el enlace aparece en la terminal.
# En producción es un error de arranque: dejaría a quien olvide su contraseña
# esperando un correo que nadie envió.
EMAIL_PROVIDER=consola
EMAIL_FROM=Atenea <no-responder@atenea.cl>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# A quien se avisa cuando algo va mal: el presupuesto de IA del dia se agota, por
# ejemplo. No es la direccion de ningun aprendiz. Si la dejas vacia, el aviso se
# queda en el registro y no sale de la maquina.
ALERT_EMAIL=

# Cuánto vive el enlace de recuperación, y a dónde abre.
PASSWORD_RESET_TTL_MIN=30
PASSWORD_RESET_URL=atenea://password/reset

# ------- Freno de peticiones (§8.7) -------
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=12/minute
