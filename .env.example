# ------- Base de datos -------
DATABASE_URL=postgresql+psycopg://atenea:atenea_dev@localhost:55432/atenea

# ------- Seguridad -------
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=60

# ------- IA -------
# mock  = proveedor determinista sin coste, para desarrollo y pruebas
# claude = Claude real (requiere ANTHROPIC_API_KEY)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_ARCHITECT=claude-opus-5
AI_MODEL_AUTHOR=claude-sonnet-5
AI_MODEL_JUDGE=claude-haiku-4-5

# ------- Embeddings -------
# mock | voyage | openai
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_DIM=512
VOYAGE_API_KEY=

# ------- Almacenamiento -------
STORAGE_DIR=./storage

# ------- Entorno -------
ENVIRONMENT=development
LOG_LEVEL=INFO
