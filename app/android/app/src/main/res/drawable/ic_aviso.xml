<!--
  El icono del recordatorio en la barra de estado.

  Android lo pinta como una silueta blanca sobre transparente, y descarta el
  color: cualquier icono con relleno acaba siendo una mancha del tamano del
  lienzo. Por eso esto no es el icono de lanzamiento de Atenea sino un escudo
  solido, que es la forma que ya identifica al Reino en la aplicacion.

  El color de aqui da igual —Android lo ignora—; se deja blanco para que la
  vista previa de Android Studio se parezca a lo que se ve en el telefono.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2L4,5v6.09c0,5.05 3.41,9.76 8,10.91 4.59,-1.15 8,-5.86 8,-10.91V5l-8,-3z" />
</vector>
